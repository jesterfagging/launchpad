# AI Agent mode (agent_v1) settings. Append the lines you need to the host
# environment file (/etc/launchpad.env on the VPS) and restart launchpad.service.
# Every value below is a placeholder. Never commit or package real keys.
#
# Rollout order: 1) LAUNCHPAD_AGENTS_ENABLED=1 with LAUNCHPAD_AGENTS_DRY_RUN=1 and no
# provider keys (intake, runs and the mock model can be exercised safely);
# 2) add the OpenRouter key and models; 3) add Browserbase; 4) record a
# provider funding batch in Admin -> AI Agents and enable settlement and the
# financial flags from the same panel. The database flags default to OFF.

# Master switch. Unset or 0 keeps every agent route answering 503 and never
# opens the ledger or spawns the worker.
LAUNCHPAD_AGENTS_ENABLED=0

# Dry run: no provider is called, runs use a deterministic mock model whose
# output is labelled "[dry run]", browsing stays off, financial actions and
# settlement cannot be enabled. Leave at 1 until the provider keys are in place.
LAUNCHPAD_AGENTS_DRY_RUN=1

# SQLite ledger (default: <data dir>/agents/agents.sqlite, created on first use).
# Keep it on the same disk as the data directory and include it in your backups.
#LAUNCHPAD_AGENTS_DB_PATH=/opt/launchpad/data/agents/agents.sqlite
# Hourly VACUUM INTO backups land here (default: <data dir>/agents/backups).
#LAUNCHPAD_AGENTS_BACKUP_DIR=/opt/launchpad/data/agents/backups

# OpenRouter: an API key from https://openrouter.ai/settings/keys funded with
# prepaid credits (the 5.5% purchase fee is an operator cost).
#LAUNCHPAD_AGENTS_OPENROUTER_KEY=sk-or-v1-replace-me
# Models: when LAUNCHPAD_AGENTS_OPENROUTER_MODELS is unset, Launchpad offers
# its built-in list of 26 models from 10 providers (OpenAI, Anthropic, Google,
# Qwen, xAI, DeepSeek, Mistral, Moonshot, MiniMax, Z.ai); a model is offered on
# the launch page only while OpenRouter's live catalog prices it and lists
# tool support. Set the variable only to restrict the list (comma-separated
# model ids; the first is the default unless LAUNCHPAD_AGENTS_DEFAULT_MODEL says
# otherwise). `node scripts/check-agent-readiness.mjs /etc/launchpad.env
# --providers` prints which ids the live catalog accepts.
#LAUNCHPAD_AGENTS_OPENROUTER_MODELS=openai/gpt-6-luna,anthropic/claude-sonnet-4.5
#LAUNCHPAD_AGENTS_DEFAULT_MODEL=openai/gpt-6-luna

# Browserbase: API key and project id from https://www.browserbase.com/settings.
# Region is optional (us-west-2, us-east-1, eu-central-1, ap-southeast-1).
#LAUNCHPAD_AGENTS_BROWSERBASE_KEY=bb_live_replace-me
#LAUNCHPAD_AGENTS_BROWSERBASE_PROJECT=00000000-0000-0000-0000-000000000000
#LAUNCHPAD_AGENTS_BROWSERBASE_REGION=us-west-2

# Operator wallet (base58) that receives USDC reimbursements for provider
# credits the operator funded. Required before Admin -> Reimburse works.
#LAUNCHPAD_AGENTS_OPERATOR_WALLET=ReplaceWithYourOperatorWalletAddress

# Platform-wide provider ceiling per UTC day in USD (policy default 10).
LAUNCHPAD_AGENTS_GLOBAL_DAILY_USD=10
# Concurrency: model runs (1-8, policy 2) and browser sessions (0-4, policy 1).
LAUNCHPAD_AGENTS_MODEL_CONCURRENCY=2
LAUNCHPAD_AGENTS_BROWSER_CONCURRENCY=1

# Vetted public domains agents may browse (read-only, https only). Creator
# requests outside this list stay unapproved. Comma-separated, lower case.
LAUNCHPAD_AGENTS_DOMAIN_ALLOWLIST=solana.com,docs.raydium.io,docs.meteora.ag,dexscreener.com

# Optional published rate-card override as JSON (must carry a "version").
# Defaults to rate-card-v2: provider cost at zero markup plus $0.002
# per started browser minute and $0.002 session overhead, pictures $0.01,
# edited pictures $0.05, clips $0.12 per second plus $0.05, consistency checks
# $0.01, X posts $0.02 ($0.22 with a link). Every Higgsfield generation is
# quoted first and refused when the quote exceeds its rate-card amount, so
# raise the matching key here if the provider's price goes above the card.
#LAUNCHPAD_AGENTS_RATE_CARD={"version":"rate-card-v3","browserMinuteUsd":2000,"browserSessionOverheadUsd":2000,"modelMarkupBps":0,"imageUsd":10000,"imageHdUsd":10000,"editUsd":50000,"videoSecondUsd":120000,"videoOverheadUsd":50000,"mediaCheckUsd":10000,"xPostUsd":20000,"xPostLinkUsd":220000}

# ---- AI influencer ---------------------------------------------------------
# Off until BOTH the credentials below are set AND the admin turns the
# "AI influencer" flag on in the admin Agents panel. Each layer is independent:
# X posting needs the X app; character pictures and clips need Higgsfield.
# Dry run (LAUNCHPAD_AGENTS_DRY_RUN=1) mocks both: no X call, no Higgsfield call,
# placeholder pictures, posts recorded as "[dry run] not sent".
#
# Higgsfield (console.higgsfield.ai -> API keys): one value "KEY_ID:KEY_SECRET".
# Charged per successful generation to the agent's operating credit at the rate
# card; failed or moderated generations are not charged by the provider.
#LAUNCHPAD_AGENTS_HIGGSFIELD_KEY=hf_key_id:hf_key_secret
# API base (default https://api.higgsfield.ai) and an optional JSON override of
# the model table ({"image":{"path":...},"edit":{"path":...},"video":{"path":...}})
# for when Higgsfield renames a model; the built-in table is documented in
# src/agent/higgsfield.mjs.
#LAUNCHPAD_AGENTS_HIGGSFIELD_URL=https://api.higgsfield.ai
#LAUNCHPAD_AGENTS_HIGGSFIELD_MODELS={"edit":{"path":"alibaba/qwen-image-3/edit"}}
# Generations in flight per host (1-4; Higgsfield accounts allow about 4).
LAUNCHPAD_AGENTS_MEDIA_CONCURRENCY=2
# OpenRouter vision model that checks every candidate picture (same character
# as the master, no minors, no real-person likeness, no nsfw). Any OpenRouter
# model id that accepts image input works; it is called with your existing
# LAUNCHPAD_AGENTS_OPENROUTER_KEY and is not subject to the agent model allowlist.
# About $0.003 per check at gpt-5-mini prices (the agent is charged $0.01).
# Without a working check no picture is kept.
LAUNCHPAD_AGENTS_VISION_MODEL=openai/gpt-5-mini
# Where portraits, pictures and clips are stored (default <data dir>/influencer;
# include it in your backups).
#LAUNCHPAD_AGENTS_MEDIA_DIR=/opt/launchpad/data/influencer
# Daily feature clip: creators may allow one 10-, 15- or 30-second
# clip per UTC day. The 30-second clip is two 15-second renders joined on this
# host with ffmpeg; without ffmpeg only 10 and 15 are offered. The service
# looks for "ffmpeg" on the PATH (install it with: sudo apt install ffmpeg);
# set this only when the binary lives elsewhere. Feature clips cost $1.31,
# $1.91 and $3.76 and are paid from the agent's operating credit; each agent's
# day budget is raised by its clip price but stays capped at 20% of its
# opening credit. Consider raising LAUNCHPAD_AGENTS_GLOBAL_DAILY_USD above when
# many agents enable feature clips (each one can add up to $3.76 a day).
#LAUNCHPAD_AGENTS_FFMPEG=/usr/bin/ffmpeg
#
# X developer app (developer.x.com -> project -> app -> User authentication
# settings: OAuth 2.0, type "Web App, Automated App or Bot" (confidential
# client), callback URL exactly https://<your host>/api/launchpad/x/callback,
# website URL your site; the app needs a payment method for X's pay-per-use
# posting: about $0.015 per post, $0.20 per post with a link).
#LAUNCHPAD_AGENTS_X_CLIENT_ID=replace-me
#LAUNCHPAD_AGENTS_X_CLIENT_SECRET=replace-me
# Defaults to <LAUNCHPAD_PUBLIC_URL>/api/launchpad/x/callback; set only when the
# public site address differs from LAUNCHPAD_PUBLIC_URL.
#LAUNCHPAD_AGENTS_X_CALLBACK_URL=https://launch.example.com/api/launchpad/x/callback
# Platform-wide ceiling of X posts per UTC day across every influencer.
LAUNCHPAD_AGENTS_X_GLOBAL_DAILY_POSTS=500

# Only for unusual layouts: an explicit path to the worker entry point.
#LAUNCHPAD_AGENTS_WORKER_PATH=/opt/launchpad/app/src/agent/worker.mjs
