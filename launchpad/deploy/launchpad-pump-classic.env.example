# Pump.fun launches. Append what you need to /etc/launchpad.env, then
# restart launchpad. Never commit or package real values.

# Master switch. Off: launch routes answer 503 and the worker never starts.
LAUNCHPAD_PUMP_CLASSIC_ENABLED=1

# Optional locations (defaults shown). Include both in your backups.
# LAUNCHPAD_PUMP_CLASSIC_DB_PATH=/opt/launchpad/data/pump-classic/pump-classic.sqlite
# LAUNCHPAD_PUMP_CLASSIC_BACKUP_DIR=/opt/launchpad/data/pump-classic/backups

# Already part of a normal install and required here:
#   LAUNCHPAD_PUBLIC_RPC_URL  dedicated mainnet RPC (simulation-heavy)
#   LAUNCHPAD_PUBLIC_URL      https address; coin metadata is served from it
# Recommended for coins on pairs other than SOL, whose Launchpad-held fee
# shares are converted to SOL through the treasury's swap route:
#   LAUNCHPAD_PUBLIC_JUPITER_KEY  server-side Jupiter API key (keyless requests are rate-limited)
