# Launchpad settings. Copy to /etc/launchpad.env (the systemd service reads it) and fill in what you use.
# Keep this file private (chmod 600): it holds API keys. Lines starting with # are off.
# Optional launch modes have their own example files in deploy/ (Pump.fun, AI Agents, transfer hooks, Robinhood Chain).

# ---------------------------------------------------------------------------------------------------------- the host
# Your website's address, exactly as visitors type it (HTTPS, no path). Required in production.
LAUNCHPAD_PUBLIC_URL=https://launch.example.com
# The app listens on 127.0.0.1:8787 behind your HTTPS reverse proxy (Caddy or nginx).
LAUNCHPAD_BIND_ADDRESS=127.0.0.1
COPYTRADER_PORT=8787
NODE_ENV=production

# Where accounts, launches and encrypted wallet keys live. Back this folder up and keep it private.
LAUNCHPAD_DATA_DIR=/opt/launchpad/data
# The key that encrypts stored wallet keys is created on first start as master.key inside the data folder. To keep it
# elsewhere, point to an existing 32-byte file readable only by the service user (it is never created for you):
# LAUNCHPAD_MASTER_KEY_FILE=/etc/launchpad/master.key

# ------------------------------------------------------------------------------------------------- Solana access
# A paid Solana mainnet RPC (Helius, QuickNode, Triton...). The public endpoint is far too slow and rate limited.
LAUNCHPAD_PUBLIC_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR-KEY
# A Jupiter API key (https://portal.jup.ag) for swaps, prices and fee conversions. Visitors never need one.
LAUNCHPAD_PUBLIC_JUPITER_KEY=
# LAUNCHPAD_PUBLIC_JUPITER_RPS=1

# --------------------------------------------------------------------------------------------------- your brand
# The name on every page, message and onchain attribution (2 to 40 characters). Default: Launchpad.
# Replace public/brand-icon.svg, brand-icon.png, brand-logo.svg, brand-avatar.png, brand-avatar.jpg, favicon.ico and
# apple-touch-icon.png with your own artwork.
LAUNCHPAD_BRAND_NAME=Launchpad
# Your X profile, linked from the site footer (optional).
# LAUNCHPAD_X_URL=https://x.com/yourname

# --------------------------------------------------------------------------------------- your own token (optional)
# With a platform token, the header shows its price, the protocol treasury buys it back and burns it with 50% of
# recognized revenue, and Analytics charts the burns. Without one the treasury keeps all revenue in SOL.
# LAUNCHPAD_TOKEN_MINT=
# Its ticker in page copy, without the $ (the templates say $LAUNCHPAD).
# LAUNCHPAD_TOKEN_SYMBOL=
# If the token was launched here in Holder rewards mode with a transfer tax, its dedicated rewards wallet can burn the
# collected tax instead of paying it out:
# LAUNCHPAD_TOKEN_BURN_WALLET=
# LAUNCHPAD_OFFICIAL_TAX_BURN_ENABLED=true
# LAUNCHPAD_OFFICIAL_TAX_AUTO_BURN=false
# A one-time burn of the inventory the rewards wallet held at launch; set its exact amount first (TAX_BURN_INITIAL_AMOUNT
# in src/launchpad-rewards-wallet.mjs, in base units):
# LAUNCHPAD_OFFICIAL_INITIAL_BURN_ENABLED=false
# Buybacks and burns you made by hand before the treasury ran, for the analytics totals (see src/protocol-manual-history.mjs).
# LAUNCHPAD_MANUAL_HISTORY_FILE=/opt/launchpad/manual-history.json

# ---------------------------------------------------------------------------------------------- capacity
# LAUNCHPAD_MAX_USERS=1000
# LAUNCHPAD_MAX_ACTIVE=5

# ------------------------------------------------------------------------------------- white-label mode (optional)
# Run this host as one white-label launchpad described by a tenant.json (see docs/WHITE-LABEL.md).
# LAUNCHPAD_PRODUCT=tenant
# LAUNCHPAD_TENANT_FILE=/opt/launchpad/tenant.json
# The share of the launchpad's protocol revenue paid to a hosting platform (basis points), its wallet and the
# smallest payout:
# LAUNCHPAD_PLATFORM_SHARE_WALLET=
# LAUNCHPAD_PLATFORM_SHARE_BPS=1000
# LAUNCHPAD_PLATFORM_SHARE_MIN_LAMPORTS=50000000
# A shared key that lets the hosting platform read the launchpad's status (x-launchpad-key header):
# LAUNCHPAD_TENANT_STATUS_KEY=

# --------------------------------------------------------------------------------------- optional launch modes
# Pump.fun launches: deploy/launchpad-pump-classic.env.example
# LAUNCHPAD_PUMP_CLASSIC_ENABLED=1
# AI Agent mode: deploy/launchpad-agents.env.example
# LAUNCHPAD_AGENTS_ENABLED=1
# Meteora transfer-hook rules: deploy/launchpad-hooks.env.example
# LAUNCHPAD_HOOK_PROGRAM_ID=
# Robinhood Chain launches and trading: deploy/launchpad-robinhood.env.example and docs/ROBINHOOD.md
# LAUNCHPAD_ROBINHOOD_ENABLED=1
# LAUNCHPAD_ROBINHOOD_LAUNCH_ENABLED=1
# Separate RPCs for the custom PumpSwap programs (default: LAUNCHPAD_PUBLIC_RPC_URL):
# LAUNCHPAD_DAMM_PUMP_RPC_URL=
# LAUNCHPAD_PUMP_PUBLIC_RPC_URL=

# ----------------------------------------------------------------------------- trading toolkit (off by default)
# The copy-trading and sniper toolkit, its Telegram bot and password accounts. Leave these off for a launchpad.
# LAUNCHPAD_ENABLE_TOOLKIT=1
# LAUNCHPAD_ENABLE_TELEGRAM=1
# LAUNCHPAD_TELEGRAM_BOT_TOKEN=
# LAUNCHPAD_TELEGRAM_ALLOWED_USERS=
# LAUNCHPAD_TELEGRAM_DATA_DIR=/opt/launchpad/telegram-data
# LAUNCHPAD_ENABLE_MANAGED_ACCOUNTS=1
